diff --git a/tests/test_pinned_actions.py b/tests/test_pinned_actions.py
new file mode 100644
index 0000000..d7c506b
--- /dev/null
+++ b/tests/test_pinned_actions.py
@@ -0,0 +1,60 @@
+"""Every action a workflow uses is pinned to a full commit, with the version
+in a comment beside it, as .claude/rules/writing.md asks.
+
+A tag can be moved by whoever publishes the action, so a workflow that names
+a tag runs whatever the tag points to on the day it runs; a commit runs what
+was reviewed. Dependabot (.github/dependabot.yml) reads the version comment
+to propose the next commit, so a pin without the comment would never move.
+One action pinned to two commits in two files would mean one of them was
+left behind by an update, so every use of an action names the same commit.
+"""
+
+import pathlib
+import re
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+WORKFLOWS = sorted((ROOT / ".github" / "workflows").glob("*.yml"))
+USES = re.compile(r"^\s*(?:- )?uses:\s*(\S+)(.*)$")
+PINNED = re.compile(r"^(?P<action>[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+)@(?P<commit>[0-9a-f]{40})$")
+VERSION_COMMENT = re.compile(r"^\s+# v\d+\.\d+\.\d+$")
+
+
+def uses_lines():
+    """Each `uses:` line of every workflow, as (file name, line number,
+    the action reference, the rest of the line)."""
+    for path in WORKFLOWS:
+        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
+            match = USES.match(line)
+            if match:
+                yield path.name, number, match.group(1), match.group(2)
+
+
+class PinnedActions(unittest.TestCase):
+
+    def test_the_workflows_use_actions(self):
+        self.assertTrue(list(uses_lines()), "no uses: line found; the reader no longer matches the files")
+
+    def test_every_action_is_pinned_to_a_commit_with_its_version_beside_it(self):
+        for name, number, reference, rest in uses_lines():
+            if reference.startswith("./"):
+                continue
+            where = f"{name}:{number}: {reference}{rest}"
+            self.assertRegex(reference, PINNED, where)
+            self.assertRegex(rest, VERSION_COMMENT, where)
+
+    def test_each_action_is_pinned_to_one_commit_everywhere(self):
+        commits = {}
+        for name, number, reference, rest in uses_lines():
+            match = PINNED.match(reference)
+            if not match:
+                continue
+            repository = "/".join(match.group("action").split("/")[:2])
+            seen = commits.setdefault(repository, {})
+            seen.setdefault((match.group("commit"), rest.strip()), []).append(f"{name}:{number}")
+        for repository, pins in commits.items():
+            self.assertEqual(len(pins), 1, f"{repository} is pinned to more than one commit: {pins}")
+
+
