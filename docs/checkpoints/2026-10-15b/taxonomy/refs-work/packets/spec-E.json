   "kind": "table 2, row 2, column 0",
   "text": "beethoven-qa"
  },
  {
   "id": "mggj4hxkexp.48744",
   "kind": "table 2, row 2, column 1",
   "text": "Contracts on every public function, by bounded symbolic search with CrossHair and Z3"
