{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "beethoven-qa",
          "version": "6.0.0",
          "informationUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md",
          "rules": [
            {
              "id": "supply-chain/pinned-action",
              "name": "PinnedAction",
              "shortDescription": {
                "text": "An action is pinned to a full commit."
              },
              "fullDescription": {
                "text": "OpenSSF Scorecard, Pinned-Dependencies."
              },
              "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#pinned-dependencies",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "supply-chain/pipe-to-shell",
              "name": "PipeToShell",
              "shortDescription": {
                "text": "No download is piped into a shell or an interpreter, or substituted into its command line."
              },
              "fullDescription": {
                "text": "OpenSSF Scorecard, Pinned-Dependencies."
              },
              "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#pinned-dependencies",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "supply-chain/unchecked-download",
              "name": "UncheckedDownload",
              "shortDescription": {
                "text": "A file a step fetches and that its job then runs, installs, unpacks, chmods or puts beside the commands is checked against a sha256 digest first; no download is piped into an unpacker."
              },
              "fullDescription": {
                "text": "OpenSSF Scorecard, Pinned-Dependencies."
              },
              "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#pinned-dependencies",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "supply-chain/token-permissions",
              "name": "TokenPermissions",
              "shortDescription": {
                "text": "A workflow declares top-level permissions that grant no write."
              },
              "fullDescription": {
                "text": "OpenSSF Scorecard, Token-Permissions."
              },
              "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#token-permissions",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "supply-chain/untrusted-checkout",
              "name": "UntrustedCheckout",
              "shortDescription": {
                "text": "A pull_request_target or workflow_run workflow never checks out the pull request."
              },
              "fullDescription": {
                "text": "OpenSSF Scorecard, Dangerous-Workflow."
              },
              "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#dangerous-workflow",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "supply-chain/script-injection",
              "name": "ScriptInjection",
              "shortDescription": {
                "text": "No run script expands an expression an outsider controls."
              },
              "fullDescription": {
                "text": "OpenSSF Scorecard, Dangerous-Workflow."
              },
              "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#dangerous-workflow",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ]
              }
            }
          ]
        }
      },
