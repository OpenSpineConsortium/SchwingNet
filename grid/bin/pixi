#!/bin/bash
# pixi for a job on a WSU compute node: SchwingNet's own (the lab volume's tools/pixi-0.81.0/bin,
# which grid/00-setup.sbatch fills, never ~/.pixi) run inside the container,
# where the environments' binaries find the glibc they were built for (grid/box.sh). A job that
# puts grid/bin first on its PATH, as the gate does for the latency jobs, runs `pixi run ...`
# unchanged.
here=$(cd "$(dirname "$0")/.." && pwd)
exec bash "$here/box.sh" "${SCHWINGNET_PIXI_BIN:-${LAB_VOLUME:-/rs/rs_grp_oschome}/go2432/tools/pixi-0.81.0/bin}/pixi" "$@"
